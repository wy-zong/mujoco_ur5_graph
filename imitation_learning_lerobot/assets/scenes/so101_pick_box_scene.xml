<?xml version="1.0" ?>
<!-- SO101 Pick Box Scene - SO101 only, no UR5e -->
<mujoco model="so101_pick_box_scene">

    <compiler angle="radian" autolimits="true" />
    <option timestep="0.002" integrator="implicitfast" solver="PGS" cone="elliptic" impratio="10">
        <!-- 啟用 multiccd 和 nativeccd 以改善碰撞偵測，防止滑脫 -->
        <flag multiccd="enable" nativeccd="enable"/>
    </option>
    
    <!-- Include SO101 robot -->
    <include file="D:/lerobot_arm/mujoco_ur5_graph/imitation_learning_lerobot/assets/SO-ARM100/Simulation/SO101/so101_new_calib.xml" />
    
    <size memory="512000000" />
    <statistic center="1.4 0.6 0.8" extent="0.8" meansize="0.08" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="120" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
                 rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
                  reflectance="0.2" />
        <mesh name="table" file="../table/sigmund_table.stl" scale="-1.5 2 1"/>
    </asset>

    <worldbody>
        <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />
        
        <!-- Coordinate axes for debugging -->
        <geom name="x-aixs" group="2" type="cylinder" contype="0" conaffinity="0"
            fromto="0 0 0 1 0 0" size="0.01" rgba="1 0 0 1" />
        <geom name="y-aixs" group="2" type="cylinder" contype="0" conaffinity="0"
            fromto="0 0 0 0 1 0" size="0.01" rgba="0 1 0 1" />
        <geom name="z-aixs" group="2" type="cylinder" contype="0" conaffinity="0"
            fromto="0 0 0 0 0 1" size="0.01" rgba="0 0 1 1" />

        <!-- Cameras -->
        <!-- top: 後方高處俯視，可看到整隻手臂和操作區域 -->
        <camera name="top" pos="0.855 0.960 2.007" xyaxes="-0.284 -0.959 -0.000 0.734 -0.218 0.643" mode="fixed" fovy="60" />
        <!-- <camera name="top_camera" pos="1.5 0.6 1.5" xyaxes="0 1 0 -1 0 1" mode="fixed" /> -->
        <!-- <camera name="hand_camera" pos="1.45 0.3 1.0" xyaxes="0 1 0 -0.5 0 1" mode="fixed" /> -->

        <!-- Target point visualization (red sphere) - controlled by environment -->
        <body name="target_marker" pos="1.3 0.6 0.8" mocap="true">
            <geom name="target_marker" type="sphere" size="0.015" rgba="1 0 0 0.8" contype="0" conaffinity="0"/>
        </body>

        <!-- Red Box (target object) - 2F85 style friction settings -->
        <body name="Box" pos="1.70 0.6 0.78" quat="1 0 0 0">
            <joint name="Box" type="free" damping="0.05"/>
            <geom name="Box" type="box" size="0.01 0.01 0.01" rgba="1 0 0 1" 
                  condim="6" />
        </body>

        <!-- Table -->
        <!-- <body name="table1" euler="0 0 0" pos="0.5 0 0.74"> -->
          <!-- <geom name="table1" type="mesh" mesh="table" group="2" rgba="0.35 0.35 0.35 1"  -->
                <!-- mass="0" contype="3" conaffinity="3" friction="1.5 0.002 0.0001"/> -->
        <!-- </body> -->
        <!-- <body name="table2" euler="0 0 0" pos="1.3 0 0.74"> -->
          <!-- <geom name="table2" type="mesh" mesh="table" group="2" rgba="0.35 0.35 0.35 1"  -->
                <!-- mass="0" contype="3" conaffinity="3" friction="1.5 0.002 0.0001"/> -->
        <!-- </body> -->
         <!--table -->
         <!-- Zones -->
		<body name="zone_pickup" pos="1.8 0.6 0.73" quat="1 0 0 0">
			<geom name="zone_pickup" type="box" size="0.2 0.6 0.01" rgba="0 1 0 0.1" contype="0" conaffinity="0"/>
		</body>
		<body name="zone_drop" pos="1.8 0.15 0.73" quat="1 0 0 0">
			<geom name="zone_drop" type="box" size="0.2 0.15 0.01" rgba="1 0 0 0.1" contype="0" conaffinity="0"/>
		</body>

		<body name = "table1" euler="0 0 0" pos= "0.5 0 0.74" >
		  <geom name = "table1" type="mesh" mesh="table" group="2" rgba="0.35 0.35 0.35 1" mass="0" contype="0" conaffinity="0" />
		</body>
		<body name = "table2" euler="0 0 0" pos= "1.3 0 0.74" >
		  <geom name = "table2" type="mesh" mesh="table" group="2" rgba="0.35 0.35 0.35 1" mass="0" contype="0" conaffinity="0" />
		</body>
        <body name="simple_table" pos="1.1 0.6 0.69" quat="1 0 0 0">
			<geom name="simple_table" type="box" size="0.8 0.6 0.05" rgba="0.5 0.5 0.5 0.1"/>
		</body>

    </worldbody>

    <equality>
        <!-- SO101 gripper grasping constraints (for future use) -->
        <weld name="grasp_so101" body1="so101_gripper" body2="Box" active="false" />
    </equality>

</mujoco>
